{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist-combined",
  "routes": [
    { "src": "/robots.txt", "has": [{ "type": "host", "value": "admin.sabalive.in" }], "dest": "/admin/robots.txt" },
    { "src": "/(?!admin/).*", "has": [{ "type": "host", "value": "admin.sabalive.in" }], "dest": "/admin/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
