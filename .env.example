# Supabase project this admin panel talks to.
# Copy this file to .env.local and fill in real values (never commit .env.local).
# The "anon"/"publishable" key is safe to ship in client code — it's protected
# entirely by Postgres RLS policies. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL: the STAGING project, so a Master / Super Admin can switch between production and staging from the top bar
# of a normal (production) build. Both values are public. Leave them out and there is no switch. In Vercel, add the same
# two variables to the production project. A `--mode staging` build ignores them (it can never reach production).
VITE_STAGING_SUPABASE_URL=https://your-staging-ref.supabase.co
VITE_STAGING_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
