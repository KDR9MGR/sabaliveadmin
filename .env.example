# Supabase project this admin panel talks to.
# Copy this file to .env.local and fill in real values (never commit .env.local).
# The "anon"/"publishable" key is safe to ship in client code — it's protected
# entirely by Postgres RLS policies. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
